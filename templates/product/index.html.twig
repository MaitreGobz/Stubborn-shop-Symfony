{% extends 'base.html.twig' %}

{% block title %}Boutique - Stubborn{% endblock %}

{% block body %}
<section class="filter-container">
    <h1>Boutique</h1>
    <form method="get" class="price-filter">
        <label for="range">Filtrer par tranche de prix</label>
        <select name="range" id="range" onchange="this.form.submit()">
            <option value="" {{currentRange is empty ? 'selected' : ''}}>Tous les prix</option>
            <option value="10-29" {{currentRange == '10-29' ? 'selected' : ''}}>10 à 29 €</option>
            <option value="29-35" {{currentRange == '29-35' ? 'selected' : ''}}>29 à 35 €</option>
            <option value="35-50" {{currentRange == '35-50' ? 'selected' : ''}}>35 à 50€</option>
        </select>
    </form>
</section>
<section class="products-grid">
    {% for product in products %}
        <div class="product-card">
            <img src="{{ asset('images/products/' ~ product.image) }}" alt="image du produit" role="img">
            <p><strong>{{ product.name }}</strong></p>
            <p>{{ product.price }} €</p>
            <a href="#{#{{ path('app_product_show', {id: product.id}) }}#}" class="product-btn">
                Voir
            </a>
        </div>
    {% endfor %}
</section>
{% endblock %}
